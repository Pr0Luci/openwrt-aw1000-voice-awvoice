{
	"luci-app-awvoice": {
		"description": "Grant access to the phone page: its settings, the phone service's status and tests",
		"read": {
			"uci": [
				"awvoice"
			],
			"file": {
				"/sbin/logread": [
					"exec"
				],
				"/sbin/logread -e awvoice-phoned": [
					"exec"
				]
			},
			"ubus": {
				"file": [
					"exec"
				],
				"system": [
					"info"
				],
				"awvoice": [
					"calls",
					"forwarding_get",
					"health",
					"message_get",
					"messages",
					"recording_get",
					"recordings",
					"status"
				]
			}
		},
		"write": {
			"uci": [
				"awvoice"
			],
			"ubus": {
				"awvoice": [
					"calls_delete",
					"hangup",
					"line_test",
					"loopback_test",
					"message_delete",
					"recording_delete",
					"reload",
					"ring_test"
				],
				"luci.awvoice": [
					"service"
				]
			}
		}
	}
}
