#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
# Copyright (C) 2026 Pr0Luci
#
# The phone service: awvoice-phoned brings the line chip up, then serves the voice path, the modem call control, the ring and
# the caller's identity until the service is stopped. The daemon reads its settings from UCI (package awvoice, section
# main) itself; a settings change reaches it as SIGHUP. If the service ends or is killed the kernel module's line watchdog
# puts the chip back in reset within its timeout, so the line is never left fed or ringing; procd restarts the service
# a few times and then leaves it down.
#
# The modem's second AT port must not be held by another program (the call control owns it): the arbiter service
# that listed it must be free of other users before this service is enabled .
# Rollback to the stage tool's service build: PROG=/usr/sbin/aw-slic-live with its options (see the tool's usage).

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/awvoice-phoned

start_service() {
	local enabled board

	config_load awvoice
	config_get_bool enabled main enabled 1
	config_get board main board /etc/awvoice/board.bin
	[ "$enabled" = 1 ] || { logger -t awvoice "switched off (awvoice.main.enabled)"; return 0; }

	[ -x "$PROG" ] || { logger -t awvoice "$PROG missing"; return 1; }
	# the package ships this board's own settings as a default: the first start copies it in place, and a
	# file already there (the user's own, kept across upgrades) is never overwritten
	if [ ! -r "$board" ] && [ -r /usr/share/awvoice/board-default.bin ]; then
		mkdir -p "$(dirname "$board")"
		cp /usr/share/awvoice/board-default.bin "$board" && chmod 600 "$board" && \
			logger -t awvoice "installed the default board file at $board"
	fi
	[ -r "$board" ] || { logger -t awvoice "board file $board missing"; return 1; }
	# the kernel module package (kmod-awvoice-fxs) loads awvoice_fxs at boot with register writes allowed (its /etc/modules.d line); if it was
	# unloaded since, it is loaded again the same way (the parameter is fixed at load time)
	[ -d /sys/module/awvoice_fxs ] || insmod "/lib/modules/$(uname -r)/awvoice_fxs.ko" allow_write=1 2>/dev/null
	[ -d /sys/module/awvoice_fxs ] || { logger -t awvoice "kernel module awvoice_fxs is not loaded (package kmod-awvoice-fxs)"; return 1; }

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5		# threshold s, wait s, at most 5 quick restarts
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# a settings change: the daemon takes it at its next idle moment (a changed channel or board makes it set the line up again)
reload_service() {
	local enabled

	config_load awvoice
	config_get_bool enabled main enabled 1
	if [ "$enabled" != 1 ]; then
		stop
	elif running; then
		procd_send_signal awvoice '*' HUP
	else
		start
	fi
}

service_triggers() {
	procd_add_reload_trigger awvoice
}
