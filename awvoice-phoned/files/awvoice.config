# SPDX-License-Identifier: GPL-2.0-only
# Default phone settings (installed as /etc/config/awvoice when none exists).
# flash_min_ms / flash_max_ms: hook-flash limits in milliseconds (set on the phone settings page).
# A hook break shorter than flash_min_ms is ignored, one between the two is the handset's flash (R) key,
# a longer one is on hook (hang-up). Set flash_max_ms a little above the handset's own flash time
# (handsets offer 100, 300, 600 or 1000 ms; 300 fits a 100 ms key; a 600 ms key needs 800, a 1000 ms key 1200). Ranges: 20..500 and 300..3000, flash_max_ms >= flash_min_ms + 100.
config phone 'main'
	option flash_min_ms '80'
	option flash_max_ms '300'
# The phone indicator LED (the router's own green:phone): solid while the line is ready, a fast blink while a call
# rings (ring_rate_ms), a slow blink while the handset is off hook (offhook_rate_ms), dark otherwise. '' = no LED.
	option led 'green:phone'
# The switch for a network phone beside the page and the handset (the SIP tab shows it as SIP on / SIP off): web asks
# for no network phone; the other words this option takes ask for one and say what serves it, and the list of them is
# with the settings reader. A word this build does not know is refused and said so, and the line stays on the side it
# was on.
config sip 'sip'
	option mode 'web'
# Other options, all with defaults (awvoice-phoned/src/daemon/config.h): enabled 0|1, channel 0|1, board <file>, at_interface 0..9 (the modem's USB interface
# of the AT port), dial_pause_s 3..15, cid dtmf|bellcore|etsi|off, cid_when ring1|prering, ringback auto|on|off (auto = the router's own ringing tone until the network's own audio is heard),
# earpiece_volume and modem_rx_gain (written to the modem only when set), my_number (shown on the status page only), region auto|<name of the number table> (auto: the numbering plan of the network the line registers on, the shipped default), hd 0|1 (HD voice is wanted; the modem is asked for that rate and the line follows its answer, so the line keeps its present rate until the modem agrees).
# Quiet hours: the phone page's Rules > Quiet hours writes these; a section of type `dnd` is one window of the day.
# option enabled 0|1 (unset is 1), from and to HH:MM (a `from` after a `to` runs through midnight), all_day 0|1 (a window
# with no span), days a list of sun|mon|tue|wed|thu|fri|sat (no list is every day), mode silent|machine|reject (unset is
# silent), repeat_min 0..1440 (the same caller again within that many minutes rings through; 0 turns that answer off)
# and allow a list of numbers that ring through whatever the window says - every section's list joins one, of at most 20.
# The first window that covers the moment decides, in the order the sections stand in this file. A contact that must ring
# through carries option ring_through '1' in its own `contact` section and needs nothing here. No `dnd` section means no
# quiet hours: the phone rings at every hour, as it does out of the box.
