# SPDX-License-Identifier: GPL-2.0-only
# Host build of the daemon's hardware-independent parts and their tests: make -f Makefile.host test
# The cross-build of the daemon itself (needs libubox, libuci and the kernel's UAPI header): make -f Makefile.host awvoice-phoned CC=<cross compiler> STAGING=<target staging dir>
CC ?= cc
CFLAGS ?= -O2 -Wall -Wextra
SAN = -fsanitize=address,undefined
CORE = src/core
DAEMON = src/daemon
INC = -I$(CORE) -I$(DAEMON) -Itests
CORE_SRC = $(addprefix $(CORE)/,chip.c board.c dnd.c stages.c converter.c line.c call.c script.c answer.c ring.c cid.c contacts.c hookwatch.c modemq.c numbers.c result.c phonebook.c blocking.c alarm.c forward.c wideband.c front_end.c)
CORE_OBJ = $(patsubst $(CORE)/%.c,build/%.o,$(CORE_SRC))
CORE_HDR = $(wildcard $(CORE)/*.h)
DAEMON_HDR = $(wildcard $(DAEMON)/*.h)
# the core's AT client finds its port with the daemon's port finder
PORT = $(DAEMON)/port.c
CALLLOG = $(DAEMON)/calllog.c
INDICATOR = $(DAEMON)/indicator.c
FAKES = tests/fakes.c tests/fakes.h

TESTS = build/test_hookwatch build/test_config build/test_board build/test_cid build/test_port build/test_daemon build/test_reply build/test_modemq build/test_numbers build/test_region_follow build/test_calllog build/test_phonebook build/test_blocking build/test_alarm build/test_forward build/test_answer build/test_indicator build/test_recording build/test_recorder build/test_machine build/test_greeting_audio build/test_storage build/test_module_abi build/test_front_end build/test_fanout build/test_qmsk build/test_guards build/test_dial_answer build/test_arbiter build/test_media_rate build/test_play_mirror build/test_web_proto build/test_play_fill build/test_provision build/test_dnd build/test_audio_path

test: core $(TESTS)
	build/test_hookwatch && echo "hookwatch: all tests passed"
	build/test_config
	build/test_board
	build/test_cid
	build/test_port
	build/test_daemon
	build/test_reply
	build/test_modemq
	build/test_numbers
	build/test_region_follow
	build/test_calllog
	build/test_phonebook
	build/test_blocking
	build/test_alarm
	build/test_forward
	build/test_answer
	build/test_indicator
	build/test_recording
	build/test_recorder
	build/test_machine
	build/test_greeting_audio
	build/test_storage
	build/test_provision
	build/test_dnd
	build/test_audio_path
	build/test_module_abi
	build/test_front_end
	build/test_fanout
	build/test_qmsk
	build/test_guards
	build/test_dial_answer
	build/test_arbiter
	build/test_media_rate
	build/test_play_mirror
	build/test_web_proto
	build/test_play_fill

# every core source compiles on its own, with the sanitizers (the core is also exercised through the stage tool's tests: make -C tools/slic test)
core: $(CORE_OBJ)

build/%.o: $(CORE)/%.c $(CORE_HDR) $(DAEMON_HDR)
	@mkdir -p build
	$(CC) $(CFLAGS) $(SAN) $(INC) -c -o $@ $<

build/test_media_rate: tests/test_media_rate.c $(CORE)/media_rate.h $(CORE)/front_end.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_media_rate.c

build/test_play_mirror: tests/test_play_mirror.c $(CORE)/play_mirror.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_play_mirror.c

# the playback ring's frame shape: how many samples one frame carries at each band
build/test_play_fill: tests/test_play_fill.c $(DAEMON)/play_fill.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_play_fill.c

# which numbering plan the line reads numbers with now: the setting, the network's code, the plan in force
build/test_region_follow: tests/test_region_follow.c $(DAEMON)/region_follow.h $(CORE)/numbers.c $(CORE)/numbers.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_region_follow.c $(CORE)/numbers.c

# the browser-audio wire: frames, RFC 6455 framing, the HTTP upgrade and its SHA-1 accept value
build/test_web_proto: tests/test_web_proto.c $(DAEMON)/web_proto.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_web_proto.c

build/test_hookwatch: tests/test_hookwatch.c $(CORE)/hookwatch.c $(CORE)/hookwatch.h
	$(CC) $(CFLAGS) $(SAN) -o $@ tests/test_hookwatch.c $(CORE)/hookwatch.c

build/test_config: tests/test_config.c $(DAEMON)/config.c $(DAEMON)/config.h $(DAEMON)/storage.h $(DAEMON)/machine.h $(DAEMON)/recorder.h $(DAEMON)/recording.h $(CORE)/hookwatch.h $(CORE)/phone.h $(CORE)/numbers.c $(CORE)/numbers.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_config.c $(DAEMON)/config.c $(CORE)/numbers.c

build/test_board: tests/test_board.c $(CORE)/board.c $(CORE)/board.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_board.c $(CORE)/board.c

build/test_cid: tests/test_cid.c $(CORE)/cid.c $(CORE)/cid.h $(CORE)/board.c $(CORE)/board.h $(CORE)/chip.c $(CORE)/chip.h $(FAKES)
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_cid.c tests/fakes.c $(CORE)/cid.c $(CORE)/board.c $(CORE)/chip.c

build/test_numbers: tests/test_numbers.c $(CORE)/numbers.c $(CORE)/numbers.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_numbers.c $(CORE)/numbers.c

build/test_port: tests/test_port.c $(PORT) $(DAEMON)/port.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_port.c $(PORT)

build/test_daemon: tests/test_daemon.c $(CORE_SRC) $(CORE_HDR) $(PORT) $(DAEMON)/port.h $(FAKES)
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_daemon.c tests/fakes.c $(CORE_SRC) $(PORT)

build/test_modemq: tests/test_modemq.c $(CORE)/modemq.c $(CORE)/modemq.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_modemq.c $(CORE)/modemq.c

build/test_reply: tests/test_reply.c $(DAEMON)/reply.c $(DAEMON)/reply.h $(INDICATOR) $(CALLLOG) $(CORE_SRC) $(CORE_HDR) $(PORT) $(FAKES)
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_reply.c $(DAEMON)/reply.c $(INDICATOR) $(CALLLOG) tests/fakes.c $(CORE_SRC) $(PORT)

build/test_indicator: tests/test_indicator.c $(INDICATOR) $(DAEMON)/config.c $(DAEMON)/indicator.h $(CORE_HDR)
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_indicator.c $(INDICATOR) $(DAEMON)/config.c $(CORE)/numbers.c

build/test_forward: tests/test_forward.c $(CORE)/forward.c $(CORE)/forward.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_forward.c $(CORE)/forward.c

build/test_answer: tests/test_answer.c $(CORE)/answer.c $(CORE)/answer.h $(PORT)
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_answer.c $(CORE)/answer.c $(PORT)

build/test_alarm: tests/test_alarm.c $(CORE)/alarm.c $(CORE)/alarm.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_alarm.c $(CORE)/alarm.c

build/test_blocking: tests/test_blocking.c $(CORE)/blocking.c $(CORE)/blocking.h $(CORE)/numbers.c $(CORE)/numbers.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_blocking.c $(CORE)/blocking.c $(CORE)/numbers.c

build/test_phonebook: tests/test_phonebook.c $(CORE)/phonebook.c $(CORE)/phonebook.h $(CORE)/numbers.c $(CORE)/numbers.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_phonebook.c $(CORE)/phonebook.c $(CORE)/numbers.c

build/test_recording: tests/test_recording.c $(DAEMON)/recording.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_recording.c

build/test_recorder: tests/test_recorder.c $(DAEMON)/recorder.c $(DAEMON)/recorder.h $(DAEMON)/recording.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_recorder.c $(DAEMON)/recorder.c

build/test_machine: tests/test_machine.c $(DAEMON)/machine.c $(DAEMON)/machine.h $(DAEMON)/greeting_audio.h $(DAEMON)/recorder.c $(DAEMON)/recorder.h $(DAEMON)/recording.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_machine.c $(DAEMON)/machine.c $(DAEMON)/recorder.c

# the greeting recording's two fixes: the silence off both ends and the tone at them (plain arithmetic on samples)
build/test_greeting_audio: tests/test_greeting_audio.c $(DAEMON)/greeting_audio.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_greeting_audio.c

build/test_dnd: tests/test_dnd.c $(CORE)/dnd.c $(CORE)/dnd.h $(CORE)/phonebook.c $(CORE)/phonebook.h $(CORE)/numbers.c
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_dnd.c $(CORE)/dnd.c $(CORE)/phonebook.c $(CORE)/numbers.c

build/test_provision: tests/test_provision.c $(DAEMON)/provision.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_provision.c

build/test_storage: tests/test_storage.c $(DAEMON)/storage.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_storage.c

build/test_module_abi: tests/test_module_abi.c $(CORE)/module_abi.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_module_abi.c

build/test_front_end: tests/test_front_end.c $(CORE)/front_end.c $(CORE)/front_end.h $(CORE)/phone.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_front_end.c $(CORE)/front_end.c

build/test_qmsk: tests/test_qmsk.c $(DAEMON)/qmsk_server.c $(DAEMON)/qmsk_server.h $(CORE)/front_end.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_qmsk.c $(DAEMON)/qmsk_server.c

build/test_dial_answer: tests/test_dial_answer.c $(CORE_SRC) $(CORE_HDR) $(PORT) $(DAEMON)/port.h $(FAKES)
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_dial_answer.c tests/fakes.c $(CORE_SRC) $(PORT)

# the audio path's life: brought up by a call or a claim, let down by the watch (src/core/phone.h)
build/test_audio_path: tests/test_audio_path.c $(CORE_SRC) $(CORE_HDR) $(PORT) $(DAEMON)/port.h $(FAKES)
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_audio_path.c tests/fakes.c $(CORE_SRC) $(PORT)

build/test_arbiter: tests/test_arbiter.c $(DAEMON)/call_arbiter.c $(DAEMON)/call_arbiter.h $(CORE)/front_end.c $(CORE)/front_end.h $(DAEMON)/qmsk_server.c $(DAEMON)/qmsk_server.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_arbiter.c $(DAEMON)/call_arbiter.c $(CORE)/front_end.c $(DAEMON)/qmsk_server.c

build/test_calllog: tests/test_calllog.c $(CALLLOG) $(DAEMON)/calllog.h $(CORE)/result.c $(CORE_HDR)
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_calllog.c $(CALLLOG) $(CORE)/result.c

build/test_guards: tests/test_guards.c $(PORT) $(DAEMON)/port.h $(DAEMON)/sip_guard.c $(DAEMON)/sip_guard.h $(CORE)/front_end.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_guards.c $(PORT) $(DAEMON)/sip_guard.c

build/test_fanout: tests/test_fanout.c $(DAEMON)/machine.c $(DAEMON)/machine.h $(DAEMON)/recorder.c $(DAEMON)/recorder.h $(DAEMON)/recording.h $(CORE)/front_end.c $(CORE)/front_end.h $(CORE)/phone.h
	$(CC) $(CFLAGS) $(SAN) $(INC) -o $@ tests/test_fanout.c $(DAEMON)/machine.c $(DAEMON)/recorder.c $(CORE)/front_end.c

# the daemon (Linux only): libubox's event loop, libubus and libuci; no sanitizers, warnings are errors
UAPI ?= ../kmod-awvoice-fxs/include/uapi
STAGING ?=
DAEMON_SRC = $(DAEMON)/main.c $(DAEMON)/hw.c $(DAEMON)/config.c $(DAEMON)/config_uci.c $(DAEMON)/api.c $(DAEMON)/reply.c $(DAEMON)/indicator.c $(CALLLOG) $(DAEMON)/recorder.c $(DAEMON)/machine.c $(PORT) $(DAEMON)/qmsk_server.c $(DAEMON)/call_arbiter.c $(DAEMON)/sip_guard.c $(DAEMON)/web_audio.c $(DAEMON)/web_tls.c $(CORE_SRC)

awvoice-phoned: $(DAEMON_SRC) $(CORE_HDR) $(DAEMON_HDR)
	$(CC) $(CFLAGS) $(CPPFLAGS) -Werror -ffunction-sections -fdata-sections $(INC) -I$(UAPI) \
		$(if $(STAGING),-I$(STAGING)/usr/include -L$(STAGING)/usr/lib) \
		-o $@ $(DAEMON_SRC) $(LDFLAGS) -lubus -lubox -luci -lmbedtls -lmbedx509 -lmbedcrypto -Wl,--gc-sections

clean:
	rm -rf build $(TESTS) awvoice-phoned
